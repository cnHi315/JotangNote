<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.NoteMapper">
    
    <!-- update --> 

    <update id="update">
        UPDATE note_table 
        <set>
            <if test="title != null">title=#{title},</if>
            <if test="content != null">content=#{content},</if>
            updated_at=#{updatedAt},
        </set>
        WHERE id = #{id}
    </update>

    <!-- insert --> 

    <insert id="insert" useGeneratedKeys="true"
             keyProperty="id">
        INSERT INTO note_table (title, content, created_at, updated_at, user_id) 
        VALUES (#{title}, #{content}, #{createdAt}, #{updatedAt}, #{userId})
    </insert>

    <!-- keywordFilter-->

    <sql id="keywordFilter">
        <where>
            <if test="keyword != null and keyword != ''">
                (title LIKE CONCAT('%', #{keyword}, '%')
                OR content LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
    </sql>

    <!-- queryByKeyword --> 

    <select id="queryByKeyword" resultType="Note">
        SELECT * FROM note_table
        <include refid="keywordFilter"></include>
        ORDER BY created_at DESC
        LIMIT #{offset}, #{pagesize}
    </select>

    <!-- getById --> 

    <select id="getById" resultType="Note">
        SELECT * FROM note_table WHERE id = #{id}
    </select>

    <!-- getNotesNumber --> 

    <select id="countByKeyword">
        SELECT COUNT(*) FROM note_table
        <include refid="keywordFilter"></include>
    </select>
</mapper>