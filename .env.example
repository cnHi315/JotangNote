# 宿主机端口，目标机器没冲突的话用默认值即可
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
WEB_PORT=80
BACKEND_PORT=8080

MYSQL_ROOT_PASSWORD=change-me
REDIS_PASSWORD=change-me
RABBITMQ_USER=cnHi
RABBITMQ_PASSWORD=change-me

# 至少 32 字节，用 openssl rand -hex 32 生成
JWT_SECRET_KEY=change-me-at-least-32-bytes-long

# 智谱 GLM 的 key，不填的话 AI 功能不可用，其它功能正常
JOTANGNOTE_API_KEY=
